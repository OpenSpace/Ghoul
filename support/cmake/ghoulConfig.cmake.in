@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(GHOUL_MODULE_ASSIMP @GHOUL_MODULE_ASSIMP@)
set(GHOUL_MODULE_COMMANDLINEPARSER @GHOUL_MODULE_COMMANDLINEPARSER@)
set(GHOUL_MODULE_FONTRENDERING @GHOUL_MODULE_FONTRENDERING@)
set(GHOUL_MODULE_LUA @GHOUL_MODULE_LUA@)
set(GHOUL_MODULE_OPENGL @GHOUL_MODULE_OPENGL@)
set(GHOUL_MODULE_SYSTEMCAPABILITIES @GHOUL_MODULE_SYSTEMCAPABILITIES@)
set(GHOUL_PROFILING @TRACY_ENABLE@)

find_dependency(glm CONFIG)
find_dependency(scn CONFIG)

# Ghoul is a static library, so its private dependencies are still needed to link a consumer
find_dependency(lz4 CONFIG)
find_dependency(tiny-process-library CONFIG)

if (GHOUL_MODULE_ASSIMP)
  find_dependency(assimp CONFIG)
endif ()

if (GHOUL_MODULE_OPENGL)
  find_dependency(OpenGL)
  find_dependency(glbinding CONFIG)
endif ()

if (GHOUL_MODULE_FONTRENDERING)
  find_dependency(Freetype)
endif ()

if (GHOUL_MODULE_LUA)
  find_dependency(unofficial-lua CONFIG)
endif ()

if (GHOUL_PROFILING)
  find_dependency(Tracy CONFIG)
endif ()

# WebSocket++ is header only and ships no CMake package, so the include directory cannot be
# recorded in the exported target and has to be located again here
find_path(GHOUL_WEBSOCKETPP_INCLUDE_DIR "websocketpp/version.hpp")
if (NOT GHOUL_WEBSOCKETPP_INCLUDE_DIR)
  set(Ghoul_FOUND FALSE)
  set(Ghoul_NOT_FOUND_MESSAGE "Could not find the WebSocket++ headers required by Ghoul")
  return ()
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/GhoulTargets.cmake")

set_property(TARGET Ghoul::Ghoul APPEND PROPERTY
  INTERFACE_INCLUDE_DIRECTORIES "${GHOUL_WEBSOCKETPP_INCLUDE_DIR}"
)

check_required_components(Ghoul)
